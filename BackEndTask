import json
import os
from datetime import datetime

# Constants for validation
VALID_DESTINATIONS = ["Delhi", "Jaipur"]
VALID_TIMES = ["Morning", "Afternoon", "Evening", "Night"]
VALID_YEARS = [1, 2, 3, 4, 5]
DATA_FILE = "cab_data.json"

class RideRequest:
    def __init__(self, name, destination, time_slot, year, submit_time=None):
        self.name = name
        self.destination = destination
        self.time_slot = time_slot
        self.year = year
        self.submit_time = submit_time or datetime.now().isoformat()

    def to_dict(self):
        return {
            "name": self.name, 
            "destination": self.destination, 
            "time_slot": self.time_slot, 
            "year": self.year, 
            "submit_time": self.submit_time
        }

    @classmethod
    def from_dict(cls, data):
        return cls(**data)
    
    # All that to store information about a ride request.


class Cab:
    def __init__(self, driver_name, seats, destination, time_slot, has_left=False, students=None):
        self.driver_name = driver_name
        self.seats = seats
        self.destination = destination
        self.time_slot = time_slot
        self.has_left = has_left
        self.students = students or []

    def to_dict(self):
        return {
            "driver_name": self.driver_name, 
            "seats": self.seats, 
            "destination": self.destination, 
            "time_slot": self.time_slot, 
            "has_left": self.has_left, 
            "students": self.students
        }

    @classmethod
    def from_dict(cls, data):
        return cls(**data)

    # All that to store information about a cab.
    # Just why is this more fun than actual academic C coding...
    # Because this is basically using Pointers but with objects in Python. 

class CabSharingApp:
    def __init__(self):
        self.requests = []
        self.cabs = []
        self.initialize_data()

    def initialize_data(self):
        # Checks if the file has data. If yes, prompts the user to load or erase.
        # And here we see first benefit of using file and not direct input...
        if os.path.exists(DATA_FILE) and os.path.getsize(DATA_FILE) > 0:
            print("Existing data found in the system.💽")
            choice = input("Continue with same data (C) or Erase and start fresh (E)? ").strip().upper()
            
            if choice == 'C':
                with open(DATA_FILE, 'r') as f:
                    data = json.load(f)
                    self.requests = [RideRequest.from_dict(r) for r in data.get('requests', [])]
                    self.cabs = [Cab.from_dict(c) for c in data.get('cabs', [])]
                print("Data loaded successfully.📀\n")
            else:
                print("Erasing old data. Starting fresh.💿\n")
                self.save_data()
                # Overwrites with empty arrays and we now can start fresh. 
        else:
            print("No existing data found. Starting fresh.💿\n")

        INITIAL_CABS_FILE = "cabs.json"
        if os.path.exists(INITIAL_CABS_FILE):
            with open(INITIAL_CABS_FILE, 'r') as f:
                cabs_data = json.load(f)
                self.cabs = [Cab.from_dict(c) for c in cabs_data]
        else:
            print(f"Warning: {INITIAL_CABS_FILE} not found. Starting with 0 cabs.")
        self.save_data()

    def save_data(self):
        # Saves current state to the JSON file. 
        # Gotta call this after every change to ensure that it's actually useful.
        data = {
            "requests": [r.to_dict() for r in self.requests],
            "cabs": [c.to_dict() for c in self.cabs]
        }
        with open(DATA_FILE, 'w') as f:
            json.dump(data, f, indent=4)
            
    def run(self):
        while True:
            print("\n---🚕Cab Sharing Menu🚕---")
            print("1. Add a new ride request🎟️")
            print("2. See everyone still waiting, plus all cabs🚖")
            print("3. Find Matches (Preview)👀")            
            print("4. Dispatch a CabCab💨")
            print("5. Quit the app🥺")            
            
            choice = input("Choose an option: ").strip()

            if choice == '1':
                self.add_request()
            elif choice == '2':
                self.view_status()
            elif choice == '3':
                self.find_matches()
            elif choice == '4':
                self.dispatch_cab()
            elif choice == '5':
                self.save_data()
                print("Data saved safely. Goodbye!👋")
                break
            else:
                print("Invalid option ❌ Please enter a number from 1 to 5.")

    def add_request(self):
        # For adding a new ride request. Was option 1 in the menu.
        print("\n---📋Ride Request📋---") 
        name = input("Student Name: ").strip()
        
        dest = input("Destination (Delhi/Jaipur): ").strip().capitalize()
        if dest not in VALID_DESTINATIONS:
            print(f"Friendly Error: We only serve {', '.join(VALID_DESTINATIONS)}.")
            return

        time_slot = input("Time (Morning/Afternoon/Evening/Night): ").strip().capitalize()
        if time_slot not in VALID_TIMES:
            print(f"Friendly Error: Time slot doesn't exist. Choose from {', '.join(VALID_TIMES)}.")
            return

        try:
            year = int(input("Year (1-5): ").strip())
            if year not in VALID_YEARS:
                print("Friendly Error: Year must be between 1 and 5 (No Year 7!).")
                return
        except ValueError:
            print("Friendly Error: Please enter a valid number for your year.")
            return

        # Create and store the request
        new_request = RideRequest(name, dest, time_slot, year)
        self.requests.append(new_request)
        self.save_data() # Save immediately after changes
        print(f"Success! Ride request added for {name}.")

    def view_status(self):
        # For viewing all students n cabs. Was option 2 in the menu.
        print("\n---🧑‍🎓Students Still Waiting🧑‍🎓---")
        if not self.requests:
            print("No students are currently waiting.")
        for req in self.requests:
            print(f"• {req.name} (Year {req.year}) -> {req.destination} ({req.time_slot})")
        
        print("\n---🚖All Cabs🚖---")
        if not self.cabs:
            print("No cabs are currently registered in the system.")
        for cab in self.cabs:
            status = "Left" if cab.has_left else "Open"
            print(f"• Driver {cab.driver_name} | {cab.destination} ({cab.time_slot}) | Seats taken: {len(cab.students)}/{cab.seats} | Status: {status}")


    def find_matches(self):
        # Shows which waiting students would get a seat in each open cab right now
        print("\n---👀Find Matches (Preview Only)👀---")
        open_cabs = [cab for cab in self.cabs if not cab.has_left]
        
        if not open_cabs:
            print("No open cabs available for matching.😔")
            return

        # Gotta go through cabs in a fixed order
        for cab in open_cabs:
            print(f"\nCab: {cab.driver_name} to {cab.destination} ({cab.time_slot}) - {cab.seats} seats total")
            
            # Find students going to the same place at the same time
            matching_students = [req for req in self.requests if req.destination == cab.destination and req.time_slot == cab.time_slot]
            
            # This is only a preview. Nobody is given a seat and the waiting list doesn't change
            # I quite frankly don't like previews. Like, isnt it better to just have a few ready made samples to show rather than a preview...
            preview_list = matching_students[:cab.seats]
            
            if preview_list:
                for student in preview_list:
                    print(f"  -> {student.name} (Year {student.year})")
            else:
                print("  -> No matching students waiting.")

 # Holy cow, I actually crossed 200 lines of code. 
 # Is this thing going to cross 400?? My fingers will hurt so bad. Or will they? Dont really know...

    def dispatch_cab(self):
        print("\n---💨Dispatch a CabCab💨---")
        open_cabs = [cab for cab in self.cabs if not cab.has_left]
        
        if not open_cabs:
            print("No open cabs left to dispatch.😔")
            return

        for i, cab in enumerate(open_cabs):
            print(f"{i + 1}. {cab.driver_name} to {cab.destination} ({cab.time_slot})")
            
        try:
            choice = int(input("Enter the number of the cab to dispatch (or 0 to cancel): ").strip())
            if choice == 0:
                return
            if choice < 1 or choice > len(open_cabs):
                print("Invalid cab number ❌ Please dont troll us. Enter a valid number.")
                return
                
            selected_cab = open_cabs[choice - 1]
            
            # When a cab leaves, it takes the students waiting for its trip. 
            # Not all due to finite no. of seats in the cab lol...
            matching_requests = [req for req in self.requests if req.destination == selected_cab.destination and req.time_slot == selected_cab.time_slot]
            
            # For now, let's take them in the order they asked. That seniority thing is a bit too much for now.
            students_to_board = matching_requests[:selected_cab.seats]
            
            for student_req in students_to_board:
                selected_cab.students.append(student_req.name)
                self.requests.remove(student_req) 
                # These students are no longer waiting... 
                # One could, but I don't want to, keep a separate list of students who have already been given a cab.
                # Aah lemme do it anyway, what's wrong with a new feature. 
                # Apparently its not that simple. HeapQ needed... Guess gotta leave it...

                
            # Once a cab has left, nobody new can be added to it. Gotta save that beautiful data.
            selected_cab.has_left = True
            self.save_data()
            
            print(f"\nSuccess! Cab driven by {selected_cab.driver_name} has left for {selected_cab.destination}.")
            print(f"Students on board: {', '.join(selected_cab.students) if selected_cab.students else 'None (Empty Cab)'}")
            
        except ValueError:
            print("Invalid input. Please enter a valid number.")

if __name__ == "__main__":
    app = CabSharingApp()
    app.run()
