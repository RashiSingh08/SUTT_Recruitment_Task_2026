import json
import os
from datetime import datetime

# Constants for validation
VALID_DESTINATIONS = ["Delhi", "Jaipur"]
VALID_TIMES = ["Morning", "Afternoon", "Evening", "Night"]
VALID_YEARS = [1, 2, 3, 4, 5]
DATA_FILE = "cab_data.json"
INITIAL_CABS_FILE = "cabs.json"

class RideRequest:
    def __init__(self, name, destination, time_slot, year, submit_time=None):
        self.name = name
        self.destination = destination
        self.time_slot = time_slot
        self.year = year
        self.submit_time = submit_time or datetime.now().isoformat()

    def to_dict(self):
        return {
            "name": self.name, 
            "destination": self.destination, 
            "time_slot": self.time_slot, 
            "year": self.year, 
            "submit_time": self.submit_time
        }

    @classmethod
    def from_dict(cls, data):
        return cls(**data)
    
    # All that to store information about a ride request.


class Cab:
    def __init__(self, driver_name, seats, destination, time_slot, has_left=False, students=None):
        self.driver_name = driver_name
        self.seats = seats
        self.destination = destination
        self.time_slot = time_slot
        self.has_left = has_left
        self.students = students or []

    def to_dict(self):
        return {
            "driver_name": self.driver_name, 
            "seats": self.seats, 
            "destination": self.destination, 
            "time_slot": self.time_slot, 
            "has_left": self.has_left, 
            "students": self.students
        }

    @classmethod
    def from_dict(cls, data):
        return cls(**data)

    # All that to store information about a cab.
    # Just why is this more fun than actual academic C coding...
    # Because this is basically using Pointers but with objects in Python. 
    # Like this a legit app and yet its somehow easier than C pointers...

class CabSharingApp:
    def __init__(self):
        self.requests = []
        self.cabs = []
        self.initialize_data()

    def initialize_data(self):
        # Checks if the file has data. If yes, prompts the user to load or erase.
        # And here we see first benefit of using file and not direct input...
        
        # Oopsies. cabs.json was being loaded AFTER the C option no matter what, so it overwrote the saved cabs every single run.
        # A cab that had already left came back as open with zero students, and those students were already deleted from requests.
        # This flag remembers whether we loaded old data, so cabs.json only gets read on a fresh start.
        loaded_existing = False

        if os.path.exists(DATA_FILE) and os.path.getsize(DATA_FILE) > 0:
            print("Existing data found in the system.💽")

            # Anything other than C, even "continue" or a typo, quietly counted as E and wiped everything...
            # Like, I realised this after myself typing continue cs I myself forgot that only C is accepted...
            # The loop now keeps asking until the input is exactly C or E, so the delete button is no longer accidental.
            # Petrol prices are the real reason this app needs to exist, but that is a different problem.
            choice = ""
            while choice not in ("C", "E"):
                choice = input("Continue with same data (C) or Erase and start fresh (E)? ").strip().upper()

            if choice == 'C':
                # I trusted my own files too much. One corrupted JSON or a missing key and from_dict(**data) crashed with a TypeError.
                # This bug was actually pointed out by AI though...
                # Wrapped the load in try/except, so a damaged file now falls back to a fresh start instead of a crash.
                # Slightly humbling that my own save file can betray me, but heyyy at least the traceback is gone.
                try:
                    with open(DATA_FILE, 'r') as f:
                        data = json.load(f)
                    self.requests = [RideRequest.from_dict(r) for r in data.get('requests', [])]
                    self.cabs = [Cab.from_dict(c) for c in data.get('cabs', [])]
                    loaded_existing = True
                    print("Data loaded successfully.📀\n")
                    # This is an app. No UI dosent mean I can't make it pretty. Emojis!!
                except (json.JSONDecodeError, TypeError, KeyError):
                    self.requests = []
                    self.cabs = []
                    print("Data file looks damaged. Starting fresh.💿\n")
            else:
                print("Erasing old data. Starting fresh.💿\n")
                self.save_data()
                # Overwrites with empty arrays and we now can start fresh. 
        else:
            print("No existing data found. Starting fresh.💿\n")

        # Only a fresh start needs the starting cabs, loaded data already has its own cabs.
        if not loaded_existing:
            if os.path.exists(INITIAL_CABS_FILE):
                # Same fragile loading problem here, a cabs.json entry with an extra or missing key would crash the whole app.
                # Same fix too, try/except and a warning. Copy paste is the only design pattern I truly master. 
                try:
                    with open(INITIAL_CABS_FILE, 'r') as f:
                        cabs_data = json.load(f)
                    self.cabs = [Cab.from_dict(c) for c in cabs_data]
                except (json.JSONDecodeError, TypeError, KeyError):
                    print(f"Warning: {INITIAL_CABS_FILE} looks damaged. Starting with 0 cabs.")
            else:
                print(f"Warning: {INITIAL_CABS_FILE} not found. Starting with 0 cabs.")
        self.save_data()

    def save_data(self):
        # Saves current state to the JSON file. 
        # Gotta call this after every change to ensure that it's actually useful...
        data = {
            "requests": [r.to_dict() for r in self.requests],
            "cabs": [c.to_dict() for c in self.cabs]
        }
        with open(DATA_FILE, 'w') as f:
            json.dump(data, f, indent=4)
            
    def run(self):
        while True:
            print("\n---🚕Cab Sharing Menu🚕---")
            print("1. Add a new ride request🎟️")
            print("2. See everyone still waiting, plus all cabs🚖")
            print("3. Find Matches (Preview)👀")            
            print("4. Dispatch a CabCab💨")
            print("5. Quit the app🥺")            
            
            choice = input("Choose an option: ").strip()

            if choice == '1':
                self.add_request()
            elif choice == '2':
                self.view_status()
            elif choice == '3':
                self.find_matches()
            elif choice == '4':
                self.dispatch_cab()
            elif choice == '5':
                self.save_data()
                print("Data saved safely. Goodbye!👋")
                break
            else:
                print("Invalid option ❌ Please enter a number from 1 to 5.")

    def add_request(self):
        # For adding a new ride request. Was option 1 in the menu.
        print("\n---📋Ride Request📋---") 
        name = input("Student Name: ").strip()

        # Earlier, an empty name sailed straight through and got a seat in the queue. 
        # A ghost passenger. And I believe in segregation so no Ghost passengers or Dogs allowed in the app...
        # Now a blank name gets rejected before anything is stored.
        if not name:
            print("Friendly Error: Name can't be empty.")
            return

        # Also the same student could submit unlimited requests and hog the queue...
        # This checks the waiting list for the same name (case-insensitive) before adding another one.
        # Honestly, spamming the cab queue is the one thing which came into my mind randomly on seeing videos about people spamming in lotteries.
        if any(req.name.lower() == name.lower() for req in self.requests):
            print(f"Friendly Error: {name} already has a request waiting.")
            return
        
        dest = input("Destination (Delhi/Jaipur): ").strip().capitalize()
        if dest not in VALID_DESTINATIONS:
            print(f"Friendly Error: We only serve {', '.join(VALID_DESTINATIONS)}.")
            return

        time_slot = input("Time (Morning/Afternoon/Evening/Night): ").strip().capitalize()
        if time_slot not in VALID_TIMES:
            print(f"Friendly Error: Time slot doesn't exist. Choose from {', '.join(VALID_TIMES)}.")
            return

        try:
            year = int(input("Year (1-5): ").strip())
            if year not in VALID_YEARS:
                print("Friendly Error: Year must be between 1 and 5 (No Year 7!).")
                return
        except ValueError:
            print("Friendly Error: Please enter a valid number for your year.")
            return

        # Create and store the request
        new_request = RideRequest(name, dest, time_slot, year)
        self.requests.append(new_request)
        self.save_data()
        print(f"Success! Ride request added for {name}.")

    def view_status(self):
        # For viewing all students n cabs. Was option 2 in the menu.
        print("\n---🧑‍🎓Students Still Waiting🧑‍🎓---")
        if not self.requests:
            print("No students are currently waiting.")
        for req in self.requests:
            print(f"• {req.name} (Year {req.year}) -> {req.destination} ({req.time_slot})")
        
        print("\n---🚖All Cabs🚖---")
        if not self.cabs:
            print("No cabs are currently registered in the system.")
        for cab in self.cabs:
            status = "Left" if cab.has_left else "Open"
            print(f"• Driver {cab.driver_name} | {cab.destination} ({cab.time_slot}) | Seats taken: {len(cab.students)}/{cab.seats} | Status: {status}")

            if cab.has_left and cab.students:
                print(f"    On board: {', '.join(cab.students)}")


    def find_matches(self):
        print("\n---👀Find Matches (Priority Preview)👀---")
        open_cabs = [cab for cab in self.cabs if not cab.has_left]
        
        if not open_cabs:
            print("No open cabs available for matching.")
            return

        for cab in open_cabs:
            print(f"\nCab: {cab.driver_name} to {cab.destination} ({cab.time_slot}) - {cab.seats} seats total")
            
            matching_students = [req for req in self.requests if req.destination == cab.destination and req.time_slot == cab.time_slot]

            # This is only a preview. Nobody is given a seat and the waiting list doesn't change
            # I quite frankly don't like previews. Like, isnt it better to just have a few ready made samples to show rather than a preview...
            
            # Phase 3: Sort by year descending.
            # I was leaning on Python's stable sort to break same-year ties, which worked but only by luck of list order.
            # The key now sorts by (-year, submit_time), so seniors go first and ties go to whoever asked earlier.
            matching_students.sort(key=lambda x: (-x.year, x.submit_time))
            # This again, did use Ai magic...

            # Preview used cab.seats directly, which ignores students already sitting in the cab.
            # Free seats = total seats minus students already on board, and max(0, ...) stops a negative number from slicing the list backwards.
            # A negative slice is the kind of bug that makes you question your degree.
            free_seats = max(0, cab.seats - len(cab.students))
            preview_list = matching_students[:free_seats]
            
            if preview_list:
                for student in preview_list:
                    print(f"  -> {student.name} (Year {student.year})")
            else:
                print("  -> No matching students waiting.")

 # Holy cow, I actually crossed 200 lines of code. 
 # Is this thing going to cross 400?? My fingers will hurt so bad. Or will they? Dont really know...

    def dispatch_cab(self):
        print("\n---💨Dispatch a CabCab💨---")
        dest = input("Enter destination (Delhi/Jaipur): ").strip().capitalize()
        time_slot = input("Enter time slot (Morning/Afternoon/Evening/Night): ").strip().capitalize()

        # Bad input used to fall into the "nobody is waiting" message, which was technically harmless but also technically a lie.
        # Reusing the VALID_ lists from add_request, so a typo now gets told it is a typo.
        if dest not in VALID_DESTINATIONS or time_slot not in VALID_TIMES:
            print("Friendly Error: Please enter a valid destination and time slot.")
            return
        
        trip_cabs = [cab for cab in self.cabs if not cab.has_left and cab.destination == dest and cab.time_slot == time_slot]
        
        matching_students = [req for req in self.requests if req.destination == dest and req.time_slot == time_slot]
        
        if not trip_cabs or not matching_students:
            print(f"\nMessage: Nobody is waiting, or there is no open cab for {dest} ({time_slot}). No changes made.")
            return
            
        selected_cab = trip_cabs[0] # Pick the first available cab for the trip
        
        # Phase 3: Seniors get in first. Python's stable sort handles same-year ties automatically...
        # Okay, I trusted the list order a bit too much here. Sorting by (-year, submit_time) makes the tie-break explicit.
        # Now it no longer depends on how the list happens to be arranged in memory.
        matching_students.sort(key=lambda x: (-x.year, x.submit_time))

        # I boarded [:selected_cab.seats] without subtracting students already in the cab. A pre-filled cab would get overbooked.
        # Free seats = seats minus students on board, and max(0, ...) keeps a negative number from slicing the list from the back.
        # Overbooking a cab is exactly how real airlines make money, so technically I was just ahead of my time.
        free_seats = max(0, selected_cab.seats - len(selected_cab.students))
        students_to_board = matching_students[:free_seats]
        
        for student_req in students_to_board:
            selected_cab.students.append(student_req.name)
            self.requests.remove(student_req) 

            # These students are no longer waiting... 
            # One could, but I don't want to, keep a separate list of students who have already been given a cab.
            # Aah lemme do it anyway, what's wrong with a new feature...
        
        # Once a cab has left, nobody new can be added to it. Gotta save that beautiful data.
            
        selected_cab.has_left = True
        self.save_data()
        
        print(f"\nSuccess! Cab driven by {selected_cab.driver_name} has left for {selected_cab.destination}.")
        print(f"Students on board: {', '.join(selected_cab.students)}")  


if __name__ == "__main__":
    app = CabSharingApp()
    app.run()

